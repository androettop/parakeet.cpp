/build*/
/.venv/
/third_party/.ggml-patch.lock
/models/*
!/models/MANIFEST.md
*.gguf
__pycache__/
*.pyc
/.cache/

# Benchmark large/derived files (audio + model weights) — NOT committed
benchmarks/audio/
benchmarks/models/
# Benchmark manifests ARE committed (small text, contain ground-truth refs)
!benchmarks/*_manifest.tsv
/examples/wasm/dist/*
!/examples/wasm/dist/parakeet.mjs
!/examples/wasm/dist/parakeet.wasm
/examples/wasm/dist-threaded/*
!/examples/wasm/dist-threaded/parakeet.mjs
!/examples/wasm/dist-threaded/parakeet.wasm
/node_modules/
/package.json
/package-lock.json
/a.out.*
